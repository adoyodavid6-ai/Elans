# --- Core ---------------------------------------------------------------
# Public base URL of the marketing site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Postgres connection used by the app (non-superuser role so RLS applies)
DATABASE_URL=postgres://elans_app:elans_app@localhost:5432/elans
# Owner connection used only by migrations/seed
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/elans
# 32+ random bytes, used to sign session cookies and resume links
SESSION_SECRET=change-me-to-a-long-random-string

# --- AI (optional: without a key, deterministic fallbacks are used) -------
ANTHROPIC_API_KEY=
ELANS_MODEL_PRIMARY=claude-opus-5-5
ELANS_MODEL_FAST=claude-haiku-5-5
# Hard monthly cap (USD) on model spend from anonymous public endpoints
ELANS_PUBLIC_AI_BUDGET_USD=50

# --- Payments: M-Pesa Daraja (sandbox until Safaricom Go-Live) ------------
# Stays in test mode (no money moves) until MPESA_ENV is sandbox/production AND the four keys below are set.
MPESA_ENV=mock            # mock | sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=          # paybill number, or the store/head-office number for a till
MPESA_PASSKEY=            # Lipa na M-Pesa Online passkey
MPESA_TILL_NUMBER=        # optional: set for Buy Goods; leave empty for Paybill
MPESA_CALLBACK_URL=       # optional: public base URL for callbacks if different from NEXT_PUBLIC_SITE_URL

# --- Payments: Paystack (cards; M-Pesa/bank via Paystack) -----------------
# Card payment buttons appear only when a key is set. sk_test_... to try, sk_live_... when live.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
PAYSTACK_CHANNELS=        # optional, e.g. card,mobile_money,bank_transfer

# --- Bot protection (Cloudflare Turnstile; empty = disabled in dev) --------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (empty = emails are written to the outbox table only) ----------
EMAIL_PROVIDER=log
EMAIL_FROM="Elans <hello@{{DOMAIN}}>"

# --- Analytics (optional; shown only after visitor consent) --------------
# Plausible: cookieless, no personal data. Leave empty to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# The one Super Admin console account (everyone else is Admin). Default: adoyodavid6@gmail.com
ELANS_SUPER_ADMIN_EMAIL=
